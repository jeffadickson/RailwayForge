<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>RailwayForge</PackageId>
    <Description>Zero-boxing .NET 11 / C# 15 Errors-as-Values and Railway-Oriented Programming library built on C# 15 [Union] structs, sync/async/ValueTask combinators, multi-error validation, and Dafny-verified monad laws.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RailwayForge.Analyzers\RailwayForge.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
